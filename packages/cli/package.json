{
  "name": "@qain/cli",
  "version": "0.0.3",
  "description": "Semantic style-regression testing for the browser. CLI.",
  "type": "module",
  "bin": { "qain": "./dist/index.js" },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qain/core": "workspace:*",
    "playwright-core": "catalog:"
  },
  "keywords": ["cli", "visual-regression", "computed-styles", "qa", "chromium", "cdp"],
  "author": "Shinyaigeek",
  "license": "MIT",
  "homepage": "https://github.com/Shinyaigeek/qain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shinyaigeek/qain.git",
    "directory": "packages/cli"
  },
  "bugs": { "url": "https://github.com/Shinyaigeek/qain/issues" },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" }
}
